---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import AdSlot from '../components/AdSlot.astro';
import { WAKE_PAGES, slugFor, type WakePage } from '../data/wake-pages';
import { absoluteUrl, url } from '../lib/site';
import { breadcrumbs, webApplication } from '../lib/jsonld';
import { DEFAULT_SETTINGS, bedtimesFor, cyclesLabel, formatDuration, parseTime } from '../lib/sleep';

export const getStaticPaths = (() =>
  WAKE_PAGES.map((page, i) => ({
    params: { slug: slugFor(page.time) },
    props: { page, prev: WAKE_PAGES[i - 1], next: WAKE_PAGES[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  page: WakePage;
  prev?: WakePage;
  next?: WakePage;
}

const { page, prev, next } = Astro.props;
const wake = parseTime(page.time)!;
const path = `${slugFor(page.time)}/`;

const options = bedtimesFor(wake, DEFAULT_SETTINGS);
const byCycles = (n: number) => options.find((o) => o.cycles === n)!;
const six = byCycles(6);
const five = byCycles(5);
const four = byCycles(4);

// Как меняется отбой при разном времени засыпания — для таблицы.
const fallVariants = [5, 15, 30].map((fallAsleep) => {
  const r = bedtimesFor(wake, { ...DEFAULT_SETTINGS, fallAsleep });
  return { fallAsleep, six: r[0].time, five: r[1].time, four: r[2].time };
});

const title = `Во сколько лечь, чтобы встать в ${page.time} — калькулятор сна`;
const description = `Чтобы встать в ${page.time} бодрым, ложитесь в ${five.time} (5 циклов, ${formatDuration(five.sleepMinutes)}) или в ${six.time} (6 циклов, ${formatDuration(six.sleepMinutes)}). Все варианты с учётом засыпания.`;
---

<Base
  title={title}
  description={description}
  path={path}
  jsonLd={[
    webApplication(absoluteUrl(path, Astro.site), description),
    breadcrumbs([
      { name: 'Калькулятор сна', url: absoluteUrl('', Astro.site) },
      { name: `Встать в ${page.time}`, url: absoluteUrl(path, Astro.site) },
    ]),
  ]}
>
  <h1>Калькулятор сна</h1>
  <p class="lead">Во сколько лечь, чтобы встать в {page.time}</p>

  <Calculator mode="wake" wake={page.time} />

  <AdSlot />

  <article class="prose">
    <p>
      <strong>Короткий ответ:</strong> чтобы проснуться в {page.time} между циклами сна, ложитесь в{' '}
      <strong>{five.time}</strong> — это {cyclesLabel(5)} и {formatDuration(five.sleepMinutes)} сна. Если хочется
      выспаться с запасом, подойдёт <strong>{six.time}</strong> ({cyclesLabel(6)}, {formatDuration(six.sleepMinutes)}).
      Крайний разумный вариант — <strong>{four.time}</strong>: {cyclesLabel(4)}, около {formatDuration(four.sleepMinutes)}.
    </p>

    <h2>Кому подходит подъём в {page.time}</h2>
    <p>{page.context}</p>

    <h2>Если засыпаете быстрее или дольше</h2>
    <p>
      Варианты выше рассчитаны для {DEFAULT_SETTINGS.fallAsleep} минут на засыпание и циклов по {DEFAULT_SETTINGS.cycle} минут.
      Вот как сдвигается время отбоя для подъёма в {page.time}, если вы засыпаете быстрее или медленнее:
    </p>
    <div class="table-wrap">
      <table>
        <caption class="visually-hidden">Время отбоя для подъёма в {page.time} в зависимости от времени засыпания</caption>
        <thead>
          <tr>
            <th scope="col">Засыпаю за</th>
            <th scope="col">6 циклов</th>
            <th scope="col">5 циклов</th>
            <th scope="col">4 цикла</th>
          </tr>
        </thead>
        <tbody>
          {
            fallVariants.map((v) => (
              <tr>
                <th scope="row">{v.fallAsleep} мин</th>
                <td>{v.six}</td>
                <td>{v.five}</td>
                <td>{v.four}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p>
      Расчёт простой: из {page.time} вычитаются время засыпания и нужное число циклов. Например, для пяти циклов:{' '}
      {page.time} − {DEFAULT_SETTINGS.fallAsleep} мин − 5 × {DEFAULT_SETTINGS.cycle} мин = {five.time}.
    </p>

    <h2>Совет</h2>
    <p>{page.tip}</p>

    <p class="note">
      Длина цикла сна индивидуальна, а 90 минут — лишь среднее значение. Расчёт носит информационный характер и не
      является медицинской рекомендацией.
    </p>

    <nav class="neighbors" aria-label="Соседнее время подъёма">
      {prev && <a href={url(slugFor(prev.time))}>← Встать в {prev.time}</a>}
      {next && <a class="next" href={url(slugFor(next.time))}>Встать в {next.time} →</a>}
    </nav>
  </article>
</Base>

<style>
  h1 {
    margin-top: 0.75rem;
    font-size: 1.5rem;
  }
  .lead {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 0 0 0.9rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  thead th {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }
  td {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .neighbors {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .neighbors a {
    padding: 0.6rem 0;
  }
  .next {
    margin-left: auto;
  }
</style>
