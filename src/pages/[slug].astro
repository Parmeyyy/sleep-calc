---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import AdSlot from '../components/AdSlot.astro';
import Highlights from '../components/Highlights.astro';
import { TIME_PAGES, fillText, pageQuestion, slugFor, type TimePage } from '../data/time-pages';
import { absoluteUrl, url } from '../lib/site';
import { breadcrumbs, webApplication } from '../lib/jsonld';
import { DEFAULT_SETTINGS, calculate, formatDuration, formatTime, parseTime } from '../lib/sleep';

export const getStaticPaths = (() =>
  TIME_PAGES.map((page) => {
    const same = TIME_PAGES.filter((p) => p.kind === page.kind);
    const i = same.indexOf(page);
    return { params: { slug: slugFor(page) }, props: { page, prev: same[i - 1], next: same[i + 1] } };
  })) satisfies GetStaticPaths;

interface Props {
  page: TimePage;
  prev?: TimePage;
  next?: TimePage;
}

const { page, prev, next } = Astro.props;
const isWake = page.kind === 'wake';
const path = `${slugFor(page)}/`;

const options = calculate(page.kind, parseTime(page.time)!, DEFAULT_SETTINGS);
const byCycles = (n: number) => options.find((o) => o.cycles === n)!;
const values: Record<string, string> = { t: page.time, coffee: formatTime(byCycles(5).minutes - 6 * 60) };
for (let k = 1; k <= 6; k++) values[`c${k}`] = byCycles(k).time;
const fill = (text: string) => fillText(text, values);

const five = byCycles(5);
const six = byCycles(6);
const question = pageQuestion(page);
const title = isWake ? `${question} — калькулятор сна` : `${question}? Калькулятор сна`;
const description = isWake
  ? `Чтобы встать в ${page.time}, ложитесь в ${five.time} (5 циклов, ${formatDuration(five.sleepMinutes)}) или в ${six.time} (6 циклов, ${formatDuration(six.sleepMinutes)}). Все варианты с учётом засыпания.`
  : `Если лечь в ${page.time}, вставайте в ${five.time} (5 циклов, ${formatDuration(five.sleepMinutes)}) или в ${six.time} (6 циклов, ${formatDuration(six.sleepMinutes)}). Все варианты с учётом засыпания.`;
const label = (p: TimePage) => (p.kind === 'wake' ? `Встать в ${p.time}` : `Лечь в ${p.time}`);
---

<Base
  title={title}
  description={description}
  path={path}
  jsonLd={[
    webApplication(absoluteUrl(path, Astro.site), description),
    breadcrumbs([
      { name: 'Калькулятор сна', url: absoluteUrl('', Astro.site) },
      { name: label(page), url: absoluteUrl(path, Astro.site) },
    ]),
  ]}
>
  <h1 class="page-title">Калькулятор сна</h1>
  <p class="lead">{question}</p>

  {isWake ? <Calculator mode="wake" wake={page.time} /> : <Calculator mode="bed" bed={page.time} />}

  <Highlights />

  <AdSlot />

  <article class="prose">
    <h2>{fill(page.tip.title)}</h2>
    <p>{fill(page.tip.text)}</p>

    <nav class="neighbors" aria-label="Соседнее время">
      {prev && <a href={url(slugFor(prev))}>← {label(prev)}</a>}
      {next && <a class="next" href={url(slugFor(next))}>{label(next)} →</a>}
    </nav>
  </article>
</Base>

<style>
  .neighbors {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .neighbors a {
    padding: 0.6rem 0;
  }
  .next {
    margin-left: auto;
  }
</style>
