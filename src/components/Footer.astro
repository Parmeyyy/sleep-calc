---
import { ARTICLES } from '../data/pages';
import { BED_PAGES, WAKE_PAGES, slugFor } from '../data/time-pages';
import { url } from '../lib/site';
---

<footer class="site-footer">
  <div class="wrap">
    <nav aria-labelledby="nav-wake">
      <p class="nav-title" id="nav-wake">Во сколько лечь, чтобы встать в:</p>
      <ul class="times">
        {WAKE_PAGES.map((p) => <li><a href={url(slugFor(p))}>{p.time}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="nav-bed">
      <p class="nav-title" id="nav-bed">Во сколько вставать, если лечь в:</p>
      <ul class="times">
        {BED_PAGES.map((p) => <li><a href={url(slugFor(p))}>{p.time}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Статьи">
      <ul class="links">
        {ARTICLES.map((a) => <li><a href={url(a.path)}>{a.label}</a></li>)}
      </ul>
    </nav>
    <p class="disclaimer">
      Это справочный расчёт, а не медицинская рекомендация. При проблемах со сном обратитесь к врачу.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
  }
  nav + nav {
    margin-top: 1.25rem;
  }
  .nav-title {
    margin: 0 0 0.5rem;
  }
  .times,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .times a {
    display: inline-block;
    min-width: 44px;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .times a:hover {
    background: var(--surface-2);
  }
  .links {
    gap: 0.25rem 1.25rem;
  }
  .links a {
    display: inline-block;
    padding: 0.4rem 0;
  }
  .disclaimer {
    margin: 1.25rem 0 0;
  }
</style>
