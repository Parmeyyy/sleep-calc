---
import { DEFAULT_SETTINGS, FALL_ASLEEP, formatDuration, napOptions, parseTime } from '../lib/sleep';

const start = '14:00';
const options = napOptions(parseTime(start)!, DEFAULT_SETTINGS);
const notes = ['самый короткий', 'короткий', 'полный цикл'];
---

<section class="nap" data-nap data-start={start} aria-label="Калькулятор дневного сна">
  <div class="time-head">
    <label for="nap-time">Ложусь в</label>
    <button type="button" class="now" data-nap-now>Ложусь сейчас</button>
  </div>
  <div class="time-wrap">
    <input id="nap-time" class="time" type="time" value={start} step="60" required />
  </div>


  <h2 id="nap-title" aria-live="polite">Если ляжете в {start}, ставьте будильник на:</h2>
  <ol class="cards">
    {
      options.map((o, i) => (
        <li class="card" data-kind={i === 2 ? 'cycle' : 'short'}>
          <span class="card-time">{o.time}</span>{' '}
          <span class="card-dur">{formatDuration(o.sleepMinutes)} сна</span>{' '}
          <span class="card-note">{notes[i]}</span>
        </li>
      ))
    }
  </ol>
  <div class="range">
    <label for="nap-fall">Засыпаю за</label>
    <input id="nap-fall" type="range" min={FALL_ASLEEP.min} max={FALL_ASLEEP.max} step="5" value={DEFAULT_SETTINGS.fallAsleep} />
    <output id="nap-fall-out" for="nap-fall">{DEFAULT_SETTINGS.fallAsleep} мин</output>
  </div>
</section>

<style>
  .nap {
    margin-top: 0.75rem;
  }
  .time-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .time-head label {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .now {
    min-height: 36px;
    padding: 0 0.85rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .now:hover {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .time {
    width: 100%;
    height: 58px;
    margin-top: 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 2.4rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .time::-webkit-date-and-time-value {
    text-align: center;
  }
  .time::-webkit-calendar-picker-indicator {
    display: none;
  }
  .range {
    display: grid;
    grid-template-columns: auto 1fr 4.2em;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .range input {
    width: 100%;
    height: 28px;
    margin: 0;
    accent-color: var(--accent);
  }
  .range output {
    text-align: right;
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  h2 {
    margin-top: 0.75rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 0.55rem 0.6rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--muted);
  }
  .card[data-kind='cycle'] {
    border-color: var(--optimal);
    background: var(--optimal-bg);
  }
  .card-time {
    font-size: clamp(1.45rem, 7.4vw, 1.9rem);
    font-weight: 750;
    line-height: 1.1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { formatDuration, formatTime, napOptions, parseTime, sanitizeSettings } from '../lib/sleep';
  import { loadSettings, saveSettings } from '../scripts/calculator';
  import { attachTimePicker } from '../scripts/time-picker';

  const root = document.querySelector<HTMLElement>('[data-nap]');
  if (root) {
    const time = root.querySelector<HTMLInputElement>('#nap-time')!;
    const fall = root.querySelector<HTMLInputElement>('#nap-fall')!;
    const fallOut = root.querySelector<HTMLOutputElement>('#nap-fall-out')!;
    const title = root.querySelector<HTMLElement>('#nap-title')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const stored = loadSettings();
    if (stored) fall.value = String(stored.fallAsleep);

    const nowMinutes = () => {
      const d = new Date();
      return d.getHours() * 60 + d.getMinutes();
    };
    let start = nowMinutes();

    const render = () => {
      const settings = sanitizeSettings({ fallAsleep: fall.valueAsNumber, cycle: stored?.cycle });
      fallOut.value = `${settings.fallAsleep} мин`;
      const value = formatTime(start);
      if (time.value !== value) time.value = value;
      title.textContent = `Если ляжете в ${value}, ставьте будильник на:`;
      napOptions(start, settings).forEach((o, i) => {
        cards[i].querySelector('.card-time')!.textContent = o.time;
        cards[i].querySelector('.card-dur')!.textContent = `${formatDuration(o.sleepMinutes)} сна`;
      });
    };

    time.addEventListener('input', () => {
      const m = parseTime(time.value);
      if (m === null) return;
      start = m;
      render();
    });
    time.addEventListener('blur', render);
    attachTimePicker(time, (m) => {
      start = m;
      render();
    });
    root.querySelector('[data-nap-now]')!.addEventListener('click', () => {
      start = nowMinutes();
      render();
    });
    fall.addEventListener('input', () => {
      render();
      saveSettings(sanitizeSettings({ fallAsleep: fall.valueAsNumber, cycle: stored?.cycle }));
    });
    render();
  }
</script>
