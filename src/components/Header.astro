---
import { SITE_NAME } from '../../site.config.mjs';
import { url } from '../lib/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={url()}>
      <svg viewBox="0 0 512 512" width="26" height="26" aria-hidden="true">
        <mask id="logo-m"><rect width="512" height="512" fill="#fff"></rect><circle cx="318" cy="200" r="132"></circle></mask>
        <circle cx="236" cy="276" r="156" fill="currentColor" mask="url(#logo-m)"></circle>
      </svg>
      <span>{SITE_NAME}</span>
    </a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Тема: как в системе">
      <svg class="i-auto" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
      </svg>
      <svg class="i-dark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="currentColor"></path>
      </svg>
      <svg class="i-light" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
        <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 650;
  }
  .logo svg {
    color: var(--accent);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--surface-2);
  }
  .theme-toggle svg {
    display: none;
  }
  :global(html:not([data-theme])) .i-auto,
  :global(html[data-theme='dark']) .i-dark,
  :global(html[data-theme='light']) .i-light {
    display: block;
  }
</style>

<script>
  const KEY = 'sleep-calc:theme';
  const ORDER = ['auto', 'dark', 'light'] as const;
  const LABEL = { auto: 'как в системе', dark: 'тёмная', light: 'светлая' };
  type Pref = (typeof ORDER)[number];

  const html = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  function current(): Pref {
    const t = html.getAttribute('data-theme');
    return t === 'dark' || t === 'light' ? t : 'auto';
  }

  function apply(pref: Pref) {
    if (pref === 'auto') html.removeAttribute('data-theme');
    else html.setAttribute('data-theme', pref);
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      const forDark = meta.media.includes('dark');
      meta.content = pref === 'auto' ? (forDark ? '#0b1020' : '#f5f6fb') : pref === 'dark' ? '#0b1020' : '#f5f6fb';
    }
    btn?.setAttribute('aria-label', `Тема: ${LABEL[pref]}. Переключить`);
    try {
      if (pref === 'auto') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, pref);
    } catch {}
  }

  apply(current());
  btn?.addEventListener('click', () => {
    apply(ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length]);
  });
</script>
