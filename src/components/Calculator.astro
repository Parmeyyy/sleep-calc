---
import {
  CYCLE,
  DEFAULT_SETTINGS,
  FALL_ASLEEP,
  QUALITY_LABEL,
  calculate,
  cyclesLabel,
  formatDuration,
  parseTime,
  resultsHeading,
  type Mode,
} from '../lib/sleep';

interface Props {
  mode?: Mode;
  /** Время подъёма для режима «Хочу встать в…». */
  wake?: string;
  /** Время отбоя для режима «Ложусь в…». */
  bed?: string;
}

const { mode = 'wake', wake = '07:00', bed = '23:00' } = Astro.props;
const time = parseTime(mode === 'wake' ? wake : bed)!;
const options = calculate(mode, time, DEFAULT_SETTINGS);
const tabs: { mode: Mode; label: string }[] = [
  { mode: 'wake', label: 'Хочу встать в…' },
  { mode: 'bed', label: 'Ложусь в…' },
];
---

<section class="calc" data-calc data-mode={mode} data-wake={wake} data-bed={bed} aria-label="Калькулятор">
  <div class="tabs" role="tablist" aria-label="Что считаем">
    {
      tabs.map((t) => (
        <button
          type="button"
          role="tab"
          id={`calc-tab-${t.mode}`}
          data-mode={t.mode}
          aria-selected={String(t.mode === mode)}
          aria-controls="calc-panel"
          tabindex={t.mode === mode ? 0 : -1}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <div id="calc-panel" class="panel" role="tabpanel" aria-labelledby={`calc-tab-${mode}`}>
    <div class="time-head">
      <label for="calc-time" id="calc-time-label">{mode === 'wake' ? 'Подъём' : 'Отбой'}</label>
      <label class="fine-toggle">
        <input type="checkbox" id="calc-fine-toggle" aria-controls="calc-fine" aria-expanded="false" />
        по минутам
      </label>
      <button type="button" class="now" data-now>Ложусь сейчас</button>
    </div>
    <div class="time-ctl">
      <button type="button" class="step" data-step="-15" aria-label="На 15 минут раньше">−</button>
      <input id="calc-time" class="time" type="time" value={mode === 'wake' ? wake : bed} step="60" required />
      <button type="button" class="step" data-step="15" aria-label="На 15 минут позже">+</button>
    </div>
    <div class="fine" id="calc-fine" hidden>
      <div class="fine-group" role="group" aria-label="Часы">
        <span class="fine-label">Часы</span>
        <button type="button" class="fine-btn" data-step="-60" aria-label="На час раньше">−1</button>
        <button type="button" class="fine-btn" data-step="60" aria-label="На час позже">+1</button>
      </div>
      <div class="fine-group" role="group" aria-label="Минуты">
        <span class="fine-label">Минуты</span>
        <button type="button" class="fine-btn" data-step="-1" aria-label="На минуту раньше">−1</button>
        <button type="button" class="fine-btn" data-step="1" aria-label="На минуту позже">+1</button>
      </div>
    </div>

    <div class="range inline">
      <label for="calc-fall">Засыпаю за</label>
      <input id="calc-fall" type="range" min={FALL_ASLEEP.min} max={FALL_ASLEEP.max} step="5" value={DEFAULT_SETTINGS.fallAsleep} />
      <output id="calc-fall-out" for="calc-fall">{DEFAULT_SETTINGS.fallAsleep} мин</output>
    </div>

  </div>

  <div class="results">
    <h2 id="calc-title" aria-live="polite">{resultsHeading(mode, time)}</h2>
    <ol class="cards">
      {
        options.map((o) => (
          <li class="card" data-quality={o.quality}>
            <span class="card-time">{o.time}</span>{' '}
            <span class="card-cycles">{cyclesLabel(o.cycles)}</span><span class="visually-hidden">,</span>{' '}
            <span class="card-dur">{formatDuration(o.sleepMinutes)}</span>{' '}
            <span class="card-badge">{QUALITY_LABEL[o.quality]}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <details class="advanced">
    <summary>Дополнительные настройки</summary>
    <div class="range">
      <label for="calc-cycle">Длина цикла сна <output id="calc-cycle-out" for="calc-cycle">{DEFAULT_SETTINGS.cycle} мин</output></label>
      <input id="calc-cycle" type="range" min={CYCLE.min} max={CYCLE.max} step="5" value={DEFAULT_SETTINGS.cycle} />
      <p class="hint">90 минут — среднее значение. Меняйте, только если знаете свой ритм.</p>
    </div>
  </details>
</section>

<style>
  .calc {
    margin-top: 0.75rem;
  }

  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .tabs button {
    min-height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  .panel {
    margin-top: 0.6rem;
  }

  .time-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .time-head label {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .time-head .fine-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    margin-right: auto;
    font-size: 0.85rem;
    cursor: pointer;
    user-select: none;
  }
  .fine-toggle input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--accent);
  }

  .fine {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 8px;
  }
  .fine[hidden] {
    display: none;
  }
  .fine-group {
    display: grid;
    grid-template-columns: 1fr 44px 44px;
    align-items: center;
    gap: 4px;
    padding: 4px 4px 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .fine-label {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .fine-btn {
    height: 40px;
    border: 0;
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
  }
  .fine-btn:active {
    background: var(--border);
  }
  .now {
    min-height: 36px;
    padding: 0 0.85rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .now:hover {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .time-ctl {
    display: grid;
    grid-template-columns: 56px 1fr 56px;
    gap: 8px;
    margin-top: 0.4rem;
  }
  .step {
    touch-action: manipulation;
    user-select: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .step:active {
    background: var(--surface-2);
  }
  .time {
    width: 100%;
    min-width: 0;
    height: 58px;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 2.4rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .time::-webkit-date-and-time-value {
    text-align: center;
  }
  .time::-webkit-calendar-picker-indicator {
    display: none;
  }

  .range {
    margin-top: 0.7rem;
  }
  .range label {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .range output {
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .range.inline {
    display: grid;
    grid-template-columns: auto 1fr 4.2em;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .range.inline output {
    text-align: right;
  }
  .range input {
    width: 100%;
    height: 28px;
    margin: 0;
    accent-color: var(--accent);
  }
  .hint {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .advanced {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }
  .advanced summary {
    display: inline-block;
    padding: 0.5rem 0;
    color: var(--accent);
    cursor: pointer;
  }
  .advanced[open] summary {
    padding-bottom: 0;
  }

  .results {
    margin-top: 0.75rem;
  }
  .results h2 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.55rem 0.6rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--muted);
  }
  .card-time {
    font-size: clamp(1.45rem, 7.4vw, 1.9rem);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .card-badge {
    margin-top: 0.3rem;
    padding: 0.05rem 0.4rem;
    font-size: 0.74rem;
    letter-spacing: 0.01em;
    border-radius: 999px;
    font-weight: 600;
  }
  .card[data-quality='optimal'] {
    border-color: var(--optimal);
    background: var(--optimal-bg);
  }
  .card[data-quality='optimal'] .card-badge {
    background: var(--optimal);
    color: var(--surface);
  }
  .card[data-quality='normal'] .card-badge {
    background: var(--normal-bg);
    color: var(--normal);
  }
  .card[data-quality='short'] .card-badge {
    background: var(--short-bg);
    color: var(--short);
  }

  @media (min-width: 560px) {
    .card {
      padding: 0.8rem 0.9rem;
      font-size: 0.9rem;
    }
    .card-time {
      font-size: 2.3rem;
    }
  }
</style>

<script>
  import { initCalculator } from '../scripts/calculator';

  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) initCalculator(root);
</script>
